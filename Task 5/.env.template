# ─────────────────────────────────────────────────────────────────────────────
#  DevOps Stack — Environment Variables Template
#  Copy this file to .env and fill in your values:
#    cp .env.template .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_secure_password

# ── Alertmanager / Webhook.site ───────────────────────────────────────────────
# Get a free webhook URL at https://webhook.site and paste the UUID below
# e.g. if your URL is https://webhook.site/abc123-..., set: abc123-...
WEBHOOK_SITE_ID=your-webhook-site-uuid-here

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
